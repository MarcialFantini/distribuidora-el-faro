---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import MovementsView from "../components/MovementsView";
export const prerender = true;
---

<Layout
  title="Movimientos — Distribuidora El Faro"
  description="Historial de movimientos con filtros por fecha, tipo y producto."
>
  <Header />
  <main
    id="main"
    class="mx-auto w-full max-w-[1320px] px-4 py-6 sm:px-6 sm:py-10"
  >
    <MovementsView client:load />
  </main>
  <footer class="mx-auto w-full max-w-[1320px] px-4 pb-10 pt-6 sm:px-6">
    <p class="text-xs text-[var(--color-ink-500)]">
      Demo local. Datos almacenados en este navegador.
    </p>
  </footer>
</Layout>
