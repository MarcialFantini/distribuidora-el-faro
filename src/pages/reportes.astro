---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import ReportsView from "../components/ReportsView";
export const prerender = true;
---

<Layout
  title="Reportes — Distribuidora El Faro"
  description="Reportes operativos: stock crítico, valorización, proyección de rotación."
>
  <Header />
  <main
    id="main"
    class="mx-auto w-full max-w-[1320px] px-4 py-6 sm:px-6 sm:py-10"
  >
    <ReportsView client:only="react" />
  </main>
  <footer class="mx-auto w-full max-w-[1320px] px-4 pb-10 pt-6 sm:px-6">
    <p class="text-xs text-[var(--color-ink-500)]">
      Demo local. Datos almacenados en este navegador.
    </p>
  </footer>
</Layout>
