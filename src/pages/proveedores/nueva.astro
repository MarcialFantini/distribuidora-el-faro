---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import NewPurchaseOrder from "../../components/NewPurchaseOrder";
export const prerender = true;
---

<Layout
  title="Nueva orden de compra — Distribuidora El Faro"
  description="Generar una nueva orden de compra a un proveedor."
>
  <Header />
  <main
    id="main"
    class="mx-auto w-full max-w-[1320px] px-4 py-6 sm:px-6 sm:py-10"
  >
    <NewPurchaseOrder client:load />
  </main>
  <footer class="mx-auto w-full max-w-[1320px] px-4 pb-10 pt-6 sm:px-6">
    <p class="text-xs text-[var(--color-ink-500)]">
      Demo local. Datos almacenados en este navegador.
    </p>
  </footer>
</Layout>
