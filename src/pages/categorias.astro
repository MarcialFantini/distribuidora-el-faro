---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import CategoriesView from "../components/CategoriesView";
export const prerender = true;
---

<Layout
  title="Categorías — Distribuidora El Faro"
  description="Métricas por categoría: productos, stock total, valor y alertas."
>
  <Header />
  <main
    id="main"
    class="mx-auto w-full max-w-[1320px] px-4 py-6 sm:px-6 sm:py-10"
  >
    <CategoriesView client:load />
  </main>
  <footer class="mx-auto w-full max-w-[1320px] px-4 pb-10 pt-6 sm:px-6">
    <p class="text-xs text-[var(--color-ink-500)]">
      Demo local. Datos almacenados en este navegador.
    </p>
  </footer>
</Layout>
